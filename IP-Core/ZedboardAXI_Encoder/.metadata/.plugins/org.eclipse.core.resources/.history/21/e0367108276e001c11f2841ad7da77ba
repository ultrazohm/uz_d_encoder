#ifndef UZ_ENCODERIP_H
#define UZ_ENCODERIP_H

// Includes
#include <stdint.h>
#include <stdbool.h>

// Typedefs
/**
 * @brief Data type for object encoderIP
 *
 */
typedef struct uz_encoderIP_t uz_encoderIP_t;

/**
 * @brief Configuration struct for encoderIP
 *
 */
struct uz_encoderIP_config_t{
    uint32_t base_address; /**< Base address of the IP-Core */
    uint32_t ip_clk_frequency_Hz; /**< Clock frequency of the IP-Core */
};



/**
 * @brief Initializes an instance of the encoderIP driver
 *
 * @param config Configuration values for the IP-Core
 * @return Pointer to initialized instance
 */
uz_encoderIP_t* uz_encoderIP_init(uz_encoderIP_config_t* config);
//uz_encoderIP_t* uz_encoderIP_init(void);

void uz_encoderIP_setConfigMode(uz_encoderIP_t* self);
void uz_encoderIP_setDataModeVelocity(uz_encoderIP_t* self);
void uz_encoderIP_setDataModePosition(uz_encoderIP_t* self);
int32_t uz_encoderIP_readData(uz_encoderIP_t* self);
int32_t uz_encoderIP_readRegister(uz_encoderIP_t* self, int32_t addr);
void uz_encoderIP_writeRegister(uz_encoderIP_t* self, int32_t addr, int32_t val);

#endif // UZ_ENCODERIP_H
