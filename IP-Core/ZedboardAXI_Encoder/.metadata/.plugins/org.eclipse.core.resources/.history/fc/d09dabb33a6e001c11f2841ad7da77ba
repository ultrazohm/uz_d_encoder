void uz_encoderIP_setLOTHighThresh(uz_encoderIP_t* self, float thresh){
	float rangeMin = 0;
	float rangeMax;
	float LSBsize;
	switch(self->config.resolution){
		case 10:
			rangeMax = 45;
			LSBsize = 0.35;
			break;

		case 12:
			rangeMax = 18;
			LSBsize = 0.14;
				break;

		case 14:
			rangeMax = 9;
			LSBsize = 0.09;
				break;

		case 16:
			rangeMax = 9;
			LSBsize = 0.09;
				break;
	}



	uz_assert(thresh <= rangeMax);
	uz_assert(thresh >= rangeMin);

	int32_t addr = 0x8D;

	int32_t val = (int) thresh/LSBsize ;
	uz_assert(val <= 127);
	uz_assert(val >= 0);

	uz_encoderIP_writeRegister(uz_encoderIP_t* self, addr, val);
}

