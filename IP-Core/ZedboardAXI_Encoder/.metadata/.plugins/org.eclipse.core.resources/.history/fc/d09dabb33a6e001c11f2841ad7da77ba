void uz_encoderIP_setExcitationFrequency(uz_encoderIP_t* self, float excFreq){


	uz_assert(excFreq <= 20000);
	uz_assert(excFreq >= 2000);

	int32_t addr = 0x91;

	int32_t fCW = (int) excFreq*(1<<15)/self->config.freq_clockin;
	uz_assert(fCW <= 0x50);
	uz_assert(fCW >= 0x4);

	uz_encoderIP_writeRegister(uz_encoderIP_t* self, addr, fCW);
}

float uz_encoderIP_getExcitationFrequency(uz_encoderIP_t* self){

	int32_t addr = 0x91;
	int32_t val = uz_encoderIP_readRegister(uz_encoderIP_t* self, addr);

	uz_assert(val <= 0x50);
	uz_assert(val >= 0x4);

	float val_f = (float) val;
	float excFreq = val_f* self->config.freq_clockin / (1<<15);

	uz_assert(excFreq <= 20000);
	uz_assert(excFreq >= 2000);

	return excFreq;
}


void uz_encoderIP_setCTRLReg(uz_encoderIP_t* self, int32_t register_value){

	uz_assert(register_value <= 0xFF);
	uz_assert(register_value >= 0);

	int32_t addr = 0x92;

	uz_encoderIP_writeRegister(uz_encoderIP_t* self, addr, register_value);
}

float uz_encoderIP_getCTRLReg(uz_encoderIP_t* self){

	int32_t addr = 0x92;
	int32_t register_value = uz_encoderIP_readRegister(uz_encoderIP_t* self, addr);

	uz_assert(register_value <= 0xFF);
	uz_assert(register_value >= 0);

	return register_value;
}


void uz_encoderIP_resetSoftware(uz_encoderIP_t* self){

	int32_t addr = 0xF0;

	uz_encoderIP_writeRegister(uz_encoderIP_t* self, addr, 0x00);

}


int32_t uz_encoderIP_getFLTRegister(uz_encoderIP_t* self){

	int32_t addr = 0xFF;

	int32_t register_value = uz_encoderIP_readRegister(uz_encoderIP_t* self, addr);

