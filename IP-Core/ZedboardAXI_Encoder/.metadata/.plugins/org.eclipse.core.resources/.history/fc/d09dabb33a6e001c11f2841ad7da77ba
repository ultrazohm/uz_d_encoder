void uz_encoderIP_setDOSResetMinMax(uz_encoderIP_t* self, float min, float max){

	uz_assert(min <= 4.82);
	uz_assert(min >= 0);

	uz_assert(max <= 4.82);
	uz_assert(max >= 0);

	uz_assert(max>min);

	int32_t addrMin = 0x8B;
	int32_t addrMax = 0x8C;

	int32_t valMin = (int) min/((1<<7)-1) ;
	uz_assert(valMin <= 127);
	uz_assert(valMin >= 0);

	uz_encoderIP_writeRegister(uz_encoderIP_t* self, addrMin, valMin);

	int32_t valMax = (int) max/((1<<7)-1) ;
	uz_assert(valMax <= 127);
	uz_assert(valMax >= 0);

	uz_encoderIP_writeRegister(uz_encoderIP_t* self, addrMax, valMax);
}

float uz_encoderIP_getDOSResetMin(uz_encoderIP_t* self){

	int32_t addrMin = 0x8B;

	int32_t valMin = uz_encoderIP_readRegister(uz_encoderIP_t* self, addrMin);

	uz_assert(valMin <= 127);
